# Публічна HTTPS-адреса API Mini App (ngrok). Панель і ефір назовні не відкриває.
[Unit]
Description=Radio 345 Mini App tunnel (ngrok)
After=network-online.target radio345-api.service
Wants=network-online.target radio345-api.service
StartLimitIntervalSec=0

[Service]
User=@USER@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/.venv/bin/python -m server.miniapp_tunnel
Restart=always
# 75 — зайнято на іншому пристрої: самі не повторюємо.
RestartPreventExitStatus=75
RestartSec=30
TimeoutStopSec=20
CPUWeight=50
MemoryHigh=200M
MemoryMax=300M
OOMScoreAdjust=600
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
