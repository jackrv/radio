# Радіовузол Radio 345 на Raspberry Pi.
# Встановлення з підстановкою користувача й шляху: docs/raspberry-pi.md, розділ «Служба».
[Unit]
Description=Radio 345 radio node (live stream + PTT)
After=network-online.target tailscaled.service sound.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/radio345
ExecStart=/home/pi/radio345/.venv/bin/python -m server.radio_node
Restart=always
RestartSec=5
# Процес відпускає ключ PTT при виході (atexit + systemd SIGTERM); KillMode лише основному процесу.
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
